# Public URL of the app (used to build share links)
APP_URL=http://localhost:3000

# PostgreSQL (the app connects to the bundled "db" service)
POSTGRES_USER=recipes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recipes

# First super admin, created on first boot if no user exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=Admin

# AI import (optional — the import page is disabled without a key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Where photos are stored inside the container
UPLOAD_DIR=/data/uploads
